---
import Base from '../layouts/Base.astro';
import LookupForm from '../components/LookupForm.astro';
import { TYPE_CODE_LABELS } from '../lib/typeCodes';
---

<Base
  title="SCAICT 證書查驗"
  description="輸入證書編號，即可確認 SCAICT 所核發證書的類別、發證日期與目前狀態。"
>
  <section class="hero">
    <h1>證書編號查驗系統</h1>
    <p>
      輸入證書上的編號，確認該證書確實由 SCAICT
      核發，並查看其類別、發證日期與目前狀態。
    </p>
  </section>

  <LookupForm autofocus />

  <section class="legend">
    <h2>證書類別代碼</h2>
    <ul>
      {
        Object.entries(TYPE_CODE_LABELS).map(([code, label]) => (
          <li>
            <code>{code}</code>
            <span>{label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <p class="note">
    為保護個人資料，查驗結果中的持有人姓名以遮罩方式呈現（如「中○喵」），
    不會顯示完整姓名。
  </p>
</Base>
