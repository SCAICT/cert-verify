---
interface Props {
  autofocus?: boolean;
}

const { autofocus = false } = Astro.props;
---

<div>
  <form class="lookup" id="lookup-form">
    <label class="sr-only" for="certificate_no">證書編號</label>
    <input
      type="text"
      id="certificate_no"
      name="certificate_no"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      autofocus={autofocus}
      required
    />
    <button type="submit">查驗</button>
  </form>
  <p class="lookup-hint">
    也可以直接貼上證書上的查驗網址，或掃描證書右下角的 QR Code。
  </p>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import { resolveCertificateUrl } from '../lib/lookup';

  const form = document.getElementById('lookup-form');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const input = document.getElementById(
      'certificate_no',
    ) as HTMLInputElement | null;
    if (!input) return;

    input.setCustomValidity('');
    const button = form?.querySelector('button');
    if (button) button.disabled = true;
    try {
      const url = await resolveCertificateUrl(input.value);
      window.location.assign(url ?? '/404.html');
    } catch {
      input.setCustomValidity('查驗服務暫時無法使用，請稍後再試。');
      input.reportValidity();
    } finally {
      if (button) button.disabled = false;
    }
  });
  document
    .getElementById('certificate_no')
    ?.addEventListener('input', (event) => {
      (event.target as HTMLInputElement).setCustomValidity('');
    });
</script>
